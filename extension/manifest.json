{
  "manifest_version": 3,
  "name": "Agent Browser Private Transport",
  "version": "0.1.0",
  "description": "Connects authorized local agents to task-owned Chrome tabs through a private native bridge.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/agent-browser-16.png",
    "32": "icons/agent-browser-32.png",
    "48": "icons/agent-browser-48.png",
    "128": "icons/agent-browser-128.png"
  },
  "action": {
    "default_title": "Pair Agent Browser with this Chrome profile",
    "default_icon": {
      "16": "icons/agent-browser-16.png",
      "32": "icons/agent-browser-32.png",
      "48": "icons/agent-browser-48.png",
      "128": "icons/agent-browser-128.png"
    }
  },
  "permissions": ["alarms", "debugger", "nativeMessaging", "storage", "webNavigation"],
  "background": {
    "service_worker": "service-worker.js"
  }
}
