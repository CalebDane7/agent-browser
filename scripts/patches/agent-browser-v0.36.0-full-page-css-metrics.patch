+fn set_selector_clip(params: &mut CaptureScreenshotParams, rect: &Rect) {
+    params.clip = Some(Viewport {
+        x: rect.x,
+        y: rect.y,
+        width: rect.width,
+        height: rect.height,
+        scale: 1.0,
+    });
+    // captureBeyondViewport defaults to false. A tall selector then produced
+    // the right PNG dimensions but blank pixels below the visible viewport.
+    // Enable it only after resolving the exact clip; no scroll or resize is needed.
+    params.capture_beyond_viewport = Some(true);
+}
+
+fn full_page_clip(metrics: &Value) -> Option<Viewport> {
+    // Screenshot clips use device-independent coordinates. Deprecated
+    // contentSize is device-scaled: preferring it applied DPR twice and padded
+    // a 1428x2400 CSS document to a 4500x7562 PNG at DPR 1.775. Prefer CSS
+    // dimensions, retaining the legacy fallback only when CSS metrics are absent.
+    let size = metrics
+        .get("cssContentSize")
+        .or_else(|| metrics.get("contentSize"))?;
+    Some(Viewport {
+        x: 0.0,
+        y: 0.0,
+        width: size.get("width").and_then(|v| v.as_f64()).unwrap_or(1280.0),
+        height: size.get("height").and_then(|v| v.as_f64()).unwrap_or(720.0),
+        scale: 1.0,
+    })
+}
