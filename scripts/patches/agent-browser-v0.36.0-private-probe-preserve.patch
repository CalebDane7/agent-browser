+fn relaunch_after_liveness_probe(private_cws: bool, alive: bool) -> Result<bool, String> {
+    if !alive && private_cws {
+        // WHY: the private provider owns an existing task capability, not a
+        // replaceable browser process. A failed 3s Page.getFrameTree probe can
+        // mean a paused/busy renderer. Closing its provider destroys the task,
+        // then reconnecting that same capability fails the WebSocket handshake.
+        // Preserve the document and report uncertainty; broker command.begin
+        // still owns true root/epoch revocation, and explicit close still retires.
+        return Err("PRIVATE_CWS_LIVENESS_UNCONFIRMED: retained the existing task capability; no relaunch attempted. Check the prior action outcome before repeating a mutation.".to_string());
+    }
+    Ok(!alive)
+}
+
+#[cfg(test)]
+mod private_cws_liveness_policy_tests {
+    use super::relaunch_after_liveness_probe;
+
+    #[test]
+    fn inconclusive_private_probe_cannot_authorize_destructive_relaunch() {
+        let error = relaunch_after_liveness_probe(true, false).unwrap_err();
+        assert!(error.starts_with("PRIVATE_CWS_LIVENESS_UNCONFIRMED:"));
+        assert!(error.contains("retained the existing task capability"));
+    }
+
+    #[test]
+    fn successful_probe_and_nonprivate_recovery_keep_their_existing_policy() {
+        assert_eq!(relaunch_after_liveness_probe(true, true), Ok(false));
+        assert_eq!(relaunch_after_liveness_probe(false, true), Ok(false));
+        assert_eq!(relaunch_after_liveness_probe(false, false), Ok(true));
+    }
+}
