-async fn handle_errors(state: &DaemonState) -> Result<Value, String> {
-    Ok(state.event_tracker.get_errors_json())
+async fn handle_errors(cmd: &Value, state: &mut DaemonState) -> Result<Value, String> {
+    // WHY: the CLI already parses and documents errors --clear, but dropping
+    // its command here silently returned the old errors. Clear only this
+    // daemon's error buffer; console entries and other owners must survive.
+    if cmd.get("clear").and_then(Value::as_bool).unwrap_or(false) {
+        state.event_tracker.error_entries.clear();
+        Ok(json!({ "cleared": true }))
+    } else {
+        Ok(state.event_tracker.get_errors_json())
+    }
 }
 
