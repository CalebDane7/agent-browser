+fn is_private_windows_upload_path(path: &str) -> bool {
+    let bytes = path.as_bytes();
+    if bytes.len() >= 3
+        && bytes[0].is_ascii_alphabetic()
+        && bytes[1] == b':'
+        && matches!(bytes[2], b'\\' | b'/')
+    {
+        return true;
+    }
+    let lower = path.to_ascii_lowercase();
+    [r"\\wsl.localhost\", r"\\wsl$\"].iter().any(|prefix| {
+        lower.strip_prefix(*prefix).is_some_and(|rest| {
+            rest.split_once('\\')
+                .is_some_and(|(distro, file)| !distro.is_empty() && !file.is_empty())
+        })
+    })
+}
+
+fn private_upload_path_error() -> ParseError {
+    ParseError::InvalidValue {
+        message: "Could not map an upload path for Windows Chrome. No upload was sent.".to_string(),
+        usage: "upload <selector> <files...>",
+    }
+}
+
+fn private_upload_paths(
+    files: &[String],
+    caller_cwd: &std::path::Path,
+    mut to_windows: impl FnMut(&std::path::Path) -> Result<String, ParseError>,
+) -> Result<Vec<String>, ParseError> {
+    files
+        .iter()
+        .map(|file| {
+            if file.is_empty() || file.bytes().any(|byte| byte < 32 || byte == 127) {
+                return Err(private_upload_path_error());
+            }
+            if is_private_windows_upload_path(file) {
+                return Ok(file.clone());
+            }
+            // Do not turn an unselected remote SMB/device namespace into file access.
+            if file.starts_with(r"\\")
+                || (!std::path::Path::new(file).is_absolute() && !caller_cwd.is_absolute())
+            {
+                return Err(private_upload_path_error());
+            }
+            // WHY: single CLI and batch both parse here in the invoking client.
+            // A daemon/broker cwd can belong to an earlier command or another task.
+            // Join before translation; never copy data or guess a distro/drive name.
+            let source_path = caller_cwd.join(file);
+            let mapped = to_windows(&source_path)?;
+            if !is_private_windows_upload_path(&mapped)
+                || mapped.bytes().any(|byte| byte < 32 || byte == 127)
+            {
+                return Err(private_upload_path_error());
+            }
+            Ok(mapped)
+        })
+        .collect()
+}
+
+fn wsl_upload_path(path: &std::path::Path) -> Result<String, ParseError> {
+    // Invoke the installed WSL mapper with a literal absolute argument, not a
+    // shell. This maps names only; Windows/Chrome readability is separate proof.
+    let output = std::process::Command::new("wslpath")
+        .args(["-w", "-a"])
+        .arg(path)
+        .output()
+        .map_err(|_| private_upload_path_error())?;
+    if !output.status.success() {
+        return Err(private_upload_path_error());
+    }
+    let output = String::from_utf8(output.stdout).map_err(|_| private_upload_path_error())?;
+    // Remove only the mapper's line ending; filename spaces remain meaningful.
+    let mapped = output.strip_suffix('\n').unwrap_or(&output);
+    Ok(mapped.strip_suffix('\r').unwrap_or(mapped).to_string())
+}
