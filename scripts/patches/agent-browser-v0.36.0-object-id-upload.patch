+    async fn test_upload_direct_page_object_and_file_access_error() {
+        use futures_util::{SinkExt, StreamExt};
+        use tokio_tungstenite::tungstenite::Message;
+
+        // Exercise the real upload producer, not a duplicate parameter builder.
+        // Old upload's extra describeNode call must fail this exact sequence.
+        for failure_code in [
+            None,
+            Some("FILE_ACCESS_REQUIRED"),
+            Some("FILE_ACCESS_UNVERIFIED"),
+        ] {
+            let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let url = format!("ws://{}", listener.local_addr().unwrap());
+            let server = tokio::spawn(async move {
+                let (stream, _) = listener.accept().await.unwrap();
+                let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+                let mut requests = Vec::new();
+                while requests.len() < 2 {
+                    let Message::Text(text) = ws.next().await.unwrap().unwrap() else {
+                        continue;
+                    };
+                    let request: Value = serde_json::from_str(&text).unwrap();
+                    let reply = if request["method"] == "Runtime.evaluate" {
+                        json!({ "id": request["id"], "result": {
+                            "result": { "type": "object", "subtype": "node", "objectId": "owned-file-object" }
+                        } })
+                    } else if let Some(code) = failure_code {
+                        json!({ "id": request["id"], "error": {
+                            "code": -32000, "message": format!("Page command failed ({code})")
+                        } })
+                    } else {
+                        json!({ "id": request["id"], "result": {} })
+                    };
+                    requests.push(request);
+                    ws.send(Message::Text(reply.to_string())).await.unwrap();
+                }
+                requests
+            });
+            let mut root = page(1, TARGET_A, "https://fixture.example/");
+            root.session_id.clear();
+            let mgr = BrowserManager {
+                client: Arc::new(CdpClient::connect(&url).await.unwrap()),
+                browser_process: None,
+                ws_url: url,
+                pages: vec![root],
+                active_page_index: 0,
+                default_timeout_ms: 25_000,
+                download_path: None,
+                ignore_https_errors: false,
+                visited_origins: HashSet::new(),
+                next_tab_id: 2,
+                direct_page: true,
+                pin_tab: true,
+                bound_target_id: Some(TARGET_A.to_string()),
+                bound_target_gone: None,
+                headless: true,
+            };
+            let files = vec![r"C:\fixture\one.txt".to_string()];
+            let result = mgr
+                .upload_files("#upload", &files, &RefMap::new(), &HashMap::new())
+                .await;
+            if let Some(code) = failure_code {
+                let error = result.unwrap_err();
+                if code == "FILE_ACCESS_REQUIRED" {
+                    assert!(error.starts_with("FILE_ACCESS_REQUIRED: No file was attached."));
+                } else {
+                    assert_eq!(error, "FILE_ACCESS_UNVERIFIED: Could not verify file access; no file was attached.");
+                    assert!(!error.contains("authorized"));
+                }
+                assert_eq!(to_ai_friendly_error(&error), error);
+            } else {
+                result.unwrap();
+            }
+            let requests = server.await.unwrap();
+            assert_eq!(requests[0]["method"], "Runtime.evaluate");
+            assert_eq!(requests[1]["method"], "DOM.setFileInputFiles");
+            assert_eq!(
+                requests[1]["params"],
+                json!({
+                    "files": files, "objectId": "owned-file-object"
+                })
+            );
+            assert!(requests
+                .iter()
+                .all(|request| request.get("sessionId").is_none()));
+        }
+    }
