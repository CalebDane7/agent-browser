+fn liveness_method(direct_page: bool) -> &'static str {
+    // A direct-page transport can expose Page without Browser (for example,
+    // chrome.debugger). Browser.getVersion would misclassify that healthy
+    // connection as dead and trigger a destructive provider close/relaunch.
+    if direct_page {
+        "Page.getFrameTree"
+    } else {
+        "Browser.getVersion"
+    }
+}
