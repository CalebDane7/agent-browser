+fn event_matches_active_page(
+    direct_page: bool,
+    active_session_id: Option<&str>,
+    event_session_id: Option<&str>,
+) -> bool {
+    // WHY: a direct-page connection stores its bound page as session "", while
+    // valid root Runtime console/exception events omit sessionId. Comparing
+    // None to Some("") silently discarded them. A missing active page is never
+    // authority, and multiplexed connections still require an exact nonempty ID.
+    match active_session_id {
+        Some("") if direct_page => event_session_id.is_none(),
+        Some(active) if !direct_page && !active.is_empty() => event_session_id == Some(active),
+        _ => false,
+    }
+}
