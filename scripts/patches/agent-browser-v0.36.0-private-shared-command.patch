+#[cfg(target_os = "linux")]
+fn require_private_daemon_peer(stream: &Connection) -> Result<(), String> {
+    use std::os::fd::AsRawFd;
+    use std::os::unix::fs::MetadataExt;
+
+    let Connection::Unix(socket) = stream else {
+        return Err("PRIVATE_DAEMON_IDENTITY_UNAVAILABLE".to_string());
+    };
+    let mut peer = libc::ucred { pid: 0, uid: 0, gid: 0 };
+    let mut size = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    let result = unsafe {
+        libc::getsockopt(socket.as_raw_fd(), libc::SOL_SOCKET, libc::SO_PEERCRED,
+            (&mut peer as *mut libc::ucred).cast(), &mut size)
+    };
+    if result != 0 || size as usize != std::mem::size_of::<libc::ucred>()
+        || peer.pid <= 0 || peer.uid != unsafe { libc::geteuid() }
+    {
+        return Err("PRIVATE_DAEMON_IDENTITY_UNAVAILABLE".to_string());
+    }
+    // WHY: SO_PEERCRED binds this connected stream, not a mutable socket path
+    // or PID file. Opening /proc/*/exe binds the actually running inode even
+    // after package replacement unlinks it. Same filename/version/disk pin is
+    // insufficient. No wire bytes are sent before this check; recheck on EVERY
+    // transaction connection so a warm-check/endpoint-replacement race fails.
+    let image = |path| fs::File::open(path).and_then(|file| file.metadata())
+        .map_err(|_| "PRIVATE_DAEMON_IDENTITY_UNAVAILABLE".to_string());
+    let caller = image("/proc/self/exe".to_string())?;
+    let daemon = image(format!("/proc/{}/exe", peer.pid))?;
+    if !caller.is_file() || !daemon.is_file()
+        || (caller.dev(), caller.ino()) != (daemon.dev(), daemon.ino())
+    {
+        return Err("PRIVATE_DAEMON_IMAGE_MISMATCH".to_string());
+    }
+    Ok(())
+}
