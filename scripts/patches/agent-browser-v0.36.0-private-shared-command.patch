+        let mut command = match parse_command(args, flags) {
+            Ok(command) => command,
+            Err(error) => json!({ "id": gen_id(), "privateParseError": error.format() }),
+        };
+        let parse_failed = command.get("privateParseError").is_some();
+        attach_plugins_to_command(&mut command, &flags.plugins);
+        attach_restore_config_to_command(&mut command, flags);
+        attach_pin_tab_to_command(&mut command, flags);
+        original.push((args, command.get("action").and_then(|value| value.as_str()).map(str::to_string)));
+        parsed.push(command);
+        if parse_failed && bail { break; }
+    }
+    if parsed.is_empty() {
+        if flags.json { println!("[]"); }
+        return;
+    }
+    let result = private_transaction(build_provider_launch_command("private-cws", flags), parsed, true, bail)
+        .and_then(|wire| send_command_with_respawn(wire, &flags.session, daemon_opts));
+    let responses = match result {
+        Ok(response) if response.success => response.data.and_then(|data| data["responses"].as_array().cloned()),
+        Ok(response) => {
+            print_response_with_opts(&response, Some("batch"), output_opts);
+            exit(1);
+        }
+        Err(error) => {
+            if flags.json { print_json_error(error); } else { eprintln!("{}", error); }
+            exit(1);
+        }
+    };
+    let Some(responses) = responses else {
+        if flags.json { print_json_error("private batch response invalid"); }
+        else { eprintln!("private batch response invalid"); }
+        exit(1);
+    };
+    let mut output = Vec::new();
+    let mut failed = false;
+    for (index, value) in responses.into_iter().enumerate() {
+        let Some((args, action)) = original.get(index) else { exit(1); };
+        let Ok(response) = serde_json::from_value::<connection::Response>(value) else { exit(1); };
+        failed |= !response.success;
+        if flags.json {
+            output.push(output::format_batch_json_response(&response, args, action.as_deref(), output_opts));
+        } else {
+            if index > 0 { println!(); }
+            print_response_with_opts(&response, action.as_deref(), output_opts);
+        }
+    }
+    if flags.json { println!("{}", serde_json::to_string(&output).unwrap_or_else(|_| "[]".to_string())); }
+    if failed { exit(1); }
+}
