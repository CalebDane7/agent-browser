+#[cfg(target_os = "linux")]
+fn private_recorded_owner_is_dead(session: &str) -> bool {
+    use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+    let observe = || -> Option<bool> {
+        let path = get_pid_path(session);
+        let file = fs::OpenOptions::new().read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK).open(&path).ok()?;
+        let before = file.metadata().ok()?;
+        if !before.is_file() || before.uid() != unsafe { libc::getuid() }
+            || before.nlink() != 1 || before.mode() & 0o022 != 0
+            || before.len() == 0 || before.len() > 32
+        {
+            return None;
+        }
+        let mut raw = String::new();
+        file.take(33).read_to_string(&mut raw).ok()?;
+        if raw.len() as u64 != before.len() || raw.len() > 32 {
+            return None;
+        }
+        let digits = raw.trim();
+        if digits.is_empty() || !digits.bytes().all(|byte| byte.is_ascii_digit()) {
+            return None;
+        }
+        let pid: u32 = digits.parse().ok()?;
+        if pid == 0 || pid > i32::MAX as u32 || is_pid_alive(pid) {
+            return Some(false);
+        }
+        // WHY: native startup records its PID before binding. An unavailable
+        // socket with a live/uncertain owner must not be replaced, but a crash
+        // must retain autonomous exact-session recovery. is_pid_alive treats
+        // only ESRCH as dead. Do not infer death from missing/malformed files.
+        // The owner+alias grant serializes this startup entry. Reject a changed
+        // record too; never widen this predicate into a general stale-file sweep.
+        let after = fs::symlink_metadata(path).ok()?;
+        Some(after.is_file()
+            && (before.dev(), before.ino(), before.len(), before.mtime(), before.mtime_nsec(),
+                before.ctime(), before.ctime_nsec())
+                == (after.dev(), after.ino(), after.len(), after.mtime(), after.mtime_nsec(),
+                    after.ctime(), after.ctime_nsec()))
+    };
+    observe().unwrap_or(false)
+}
