+fn private_transaction(
+    launch: serde_json::Value, commands: Vec<serde_json::Value>, batch: bool, bail: bool,
+) -> Result<serde_json::Value, String> {
+    use std::io::Read;
+    let path = env::var("AGENT_BROWSER_PROVIDER_GRANT_PATH").map_err(|_| "grant_unavailable")?;
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW);
+    }
+    let file = options.open(path).map_err(|_| "grant_unavailable")?;
+    let metadata = file.metadata().map_err(|_| "grant_unavailable")?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::getuid() } || metadata.mode() & 0o077 != 0 ||
+            metadata.nlink() != 1 { return Err("grant_invalid".to_string()); }
+    }
+    if !metadata.is_file() || metadata.len() > 65536 { return Err("grant_invalid".to_string()); }
+    let mut text = String::new();
+    file.take(65537).read_to_string(&mut text).map_err(|_| "grant_invalid")?;
+    if text.len() > 65536 { return Err("grant_invalid".to_string()); }
+    let grant: serde_json::Value = serde_json::from_str(&text).map_err(|_| "grant_invalid")?;
+    Ok(json!({ "id": gen_id(), "action": "private_cws_transaction",
+        "grant": grant, "launch": launch, "commands": commands, "batch": batch, "bail": bail }))
