+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn private_execution_accepts_only_one_page_capability() {
+        let value = json!({ "command": "a".repeat(64), "cleanup": "b".repeat(64),
+            "cdpUrl": format!("ws://127.0.0.1:1234/page/{}", "c".repeat(64)) });
+        assert!(parse_execution(&value).is_ok());
+        let mut bad = value;
+        bad["cdpUrl"] = json!("ws://127.0.0.1:1234/devtools/browser/not-a-page");
+        assert!(parse_execution(&bad).is_err());
+    }
+    #[tokio::test]
+    async fn only_execution_scoped_frames_carry_generation() {
+        let message = json!({ "id": 1, "method": "Input.insertText", "params": { "text": "fixture" } });
+        assert!(!encode_cdp(&message).unwrap().contains("agentBrowserCommand"));
+        let encoded = EXECUTION.scope(Execution {
+            command: "a".repeat(64), cdp_url: String::new(), cleanup: String::new(),
+        }, async { encode_cdp(&message).unwrap() }).await;
+        assert_eq!(serde_json::from_str::<Value>(&encoded).unwrap()["agentBrowserCommand"], "a".repeat(64));
+    }
+}
