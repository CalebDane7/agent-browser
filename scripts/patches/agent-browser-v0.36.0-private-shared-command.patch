+//! Private-CWS execution ownership. This is an internal provider transaction,
+//! not a browser-wide capability or a CLI-exit lock.
+use serde_json::{json, Value};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use super::actions::{execute_command, DaemonState};
+use super::providers::{ProviderConnection, ProviderSession};
+
+const SCHEMA: &str = "agent-browser.extension-control.v1";
+#[derive(Clone)]
+struct Execution { command: String, cdp_url: String, cleanup: String }
+tokio::task_local! { static EXECUTION: Execution; }
+
+fn opaque(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+pub fn encode_cdp<T: serde::Serialize>(value: &T) -> Result<String, String> {
+    let mut message = serde_json::to_value(value).map_err(|_| "CDP serialization failed")?;
+    if let Ok(command) = EXECUTION.try_with(|execution| execution.command.clone()) {
+        message["agentBrowserCommand"] = json!(command);
+    }
+    serde_json::to_string(&message).map_err(|_| "CDP serialization failed".to_string())
+}
+
+pub fn provider_connection() -> Option<ProviderConnection> {
+    EXECUTION.try_with(|execution| ProviderConnection {
+        ws_url: execution.cdp_url.clone(), direct_page: true, metadata: None,
+        session: Some(ProviderSession {
+            provider: "plugin:private-cws".to_string(),
+            session_id: json!(execution.cleanup).to_string(),
+        }),
+    }).ok()
+}
+
+fn parse_execution(value: &Value) -> Result<Execution, String> {
+    if !value.as_object().is_some_and(|object| object.len() == 3) {
+        return Err("COMMAND_ENVELOPE_INVALID".to_string());
+    }
+    let command = value["command"].as_str().ok_or("COMMAND_ENVELOPE_INVALID")?;
+    let cleanup = value["cleanup"].as_str().ok_or("COMMAND_ENVELOPE_INVALID")?;
+    let cdp_url = value["cdpUrl"].as_str().ok_or("COMMAND_ENVELOPE_INVALID")?;
+    let url = url::Url::parse(cdp_url).map_err(|_| "COMMAND_ENVELOPE_INVALID")?;
+    if !opaque(command) || !opaque(cleanup) || url.scheme() != "ws" ||
+        url.host_str() != Some("127.0.0.1") || url.port().is_none() ||
+        !url.username().is_empty() || url.password().is_some() ||
+        url.query().is_some() || url.fragment().is_some() ||
+        !url.path().strip_prefix("/page/").is_some_and(opaque) {
+        return Err("COMMAND_ENVELOPE_INVALID".to_string());
+    }
+    Ok(Execution { command: command.to_string(), cleanup: cleanup.to_string(), cdp_url: cdp_url.to_string() })
+}
+
+#[cfg(unix)]
+async fn control(mut request: Value, id: &str) -> Result<Value, String> {
+    if !opaque(id) { return Err("COMMAND_ENVELOPE_INVALID".to_string()); }
+    request["schema"] = json!(SCHEMA);
+    request["id"] = json!(id);
+    let path = std::env::var("AGENT_BROWSER_EXTENSION_CONTROL_SOCKET")
+        .map_err(|_| "CONTROL_UNAVAILABLE")?;
+    if !std::path::Path::new(&path).is_absolute() { return Err("CONTROL_UNAVAILABLE".to_string()); }
+    let mut socket = tokio::net::UnixStream::connect(path).await.map_err(|_| "CONTROL_UNAVAILABLE")?;
+    let encoded = request.to_string() + "\n";
+    if encoded.len() > 65536 { return Err("COMMAND_ENVELOPE_INVALID".to_string()); }
+    socket.write_all(encoded.as_bytes()).await.map_err(|_| "CONTROL_UNAVAILABLE")?;
+    let mut bytes = Vec::new();
+    let mut chunk = [0u8; 8192];
+    loop {
+        let count = socket.read(&mut chunk).await.map_err(|_| "CONTROL_UNAVAILABLE")?;
+        if count == 0 { return Err("CONTROL_UNAVAILABLE".to_string()); }
+        bytes.extend_from_slice(&chunk[..count]);
+        if bytes.len() > 65536 { return Err("COMMAND_ENVELOPE_INVALID".to_string()); }
+        if let Some(end) = bytes.iter().position(|b| *b == b'\n') {
+            if end + 1 != bytes.len() { return Err("COMMAND_ENVELOPE_INVALID".to_string()); }
+            let response: Value = serde_json::from_slice(&bytes[..end]).map_err(|_| "COMMAND_ENVELOPE_INVALID")?;
+            if response["schema"] != SCHEMA || response["id"] != id { return Err("COMMAND_ENVELOPE_INVALID".to_string()); }
+            if response["ok"] != true {
+                let code = response["error"]["code"].as_str().unwrap_or("CONTROL_REJECTED");
+                return Err(if code.len() <= 64 && code.bytes().all(|c| c.is_ascii_uppercase() || c == b'_') {
+                    code.to_string()
+                } else { "CONTROL_REJECTED".to_string() });
+            }
+            return Ok(response["result"].clone());
+        }
+    }
+}
+
+#[cfg(not(unix))]
+async fn control(_request: Value, _id: &str) -> Result<Value, String> {
+    Err("PRIVATE_CWS_REQUIRES_UNIX".to_string())
+}
+
+fn error(cmd: &Value, message: &str) -> Value {
+    json!({ "id": cmd["id"], "success": false, "error": message })
+}
+
+pub async fn execute(transaction: &Value, state: &mut DaemonState) -> Value {
+    let grant = &transaction["grant"];
+    let Some(nonce) = grant["nonce"].as_str() else { return error(transaction, "COMMAND_ENVELOPE_INVALID"); };
+    let Some(commands) = transaction["commands"].as_array() else { return error(transaction, "COMMAND_ENVELOPE_INVALID"); };
+    if commands.is_empty() || !opaque(nonce) ||
+        std::env::var("AGENT_BROWSER_SESSION").ok().as_deref() != grant["session"].as_str() ||
+        transaction["launch"]["provider"] != "private-cws" {
+        return error(transaction, "COMMAND_ENVELOPE_INVALID");
+    }
+    let begin = control(json!({ "op": "command.begin", "grant": grant, "daemonPid": std::process::id() }), nonce).await;
+    let execution = match begin.and_then(|result| parse_execution(&result)) {
+        Ok(execution) => execution,
+        Err(message) => return error(transaction, &message),
+    };
+    let command = execution.command.clone();
+    // WHY: preflight and action share one native execution lifetime. The CLI
+    // may disconnect while this future still emits input; only this completion
+    // boundary, or independently proven daemon death, permits another writer.
+    let response = EXECUTION.scope(execution, async {
+        let launched = execute_command(&transaction["launch"], state).await;
+        if launched["success"] != true { return launched; }
+        let mut responses = Vec::new();
+        for command in commands {
+            let response = if let Some(message) = command["privateParseError"].as_str() {
+                error(command, message)
+            } else {
+                execute_command(command, state).await
+            };
+            let failed = response["success"] != true;
+            responses.push(response);
+            if failed && transaction["bail"] == true { break; }
+        }
+        if transaction["batch"] == true {
+            json!({ "id": transaction["id"], "success": true, "data": { "responses": responses } })
+        } else { responses.remove(0) }
+    }).await;
+    // No timeout means cancellation here. If transport is lost, broker/worker
+    // epoch fencing rejects old frames; exact daemon death remains observable.
+    if let Err(message) = control(json!({
+        "op": "command.end", "command": command, "daemonPid": std::process::id()
+    }), &command).await { return error(transaction, &message); }
+    response
+}
