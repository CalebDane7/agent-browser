+fn finish_response(transaction: &Value, mut response: Value, cleanup: Result<(), String>) -> Value {
+    let Err(message) = cleanup else { return response; };
+    let diagnostic = format!("Command cleanup failed ({message}).");
+    let append_warning = |response: &mut Value, message: String| {
+        response["warning"] = match response["warning"].as_str() {
+            Some(previous) => json!(format!("{previous}\n{message}")),
+            None => json!(message),
+        };
+    };
+    if response["success"] != true {
+        // WHY: command.end is a fence/cleanup acknowledgement, not the page action.
+        // Replacing an earlier page error hid the causal red and invited unsafe retries.
+        append_warning(&mut response, diagnostic);
+        return response;
+    }
+    let warning = if transaction["batch"] == true {
+        format!("{diagnostic} Completed batch results remain in data.responses; do not repeat successful actions.")
+    } else {
+        format!("{diagnostic} The command returned success; its result remains in data. Do not repeat the action.")
+    };
+    response["success"] = json!(false);
+    response["error"] = json!("COMMAND_CLEANUP_FAILED");
+    response["code"] = json!("command_cleanup_failed");
+    append_warning(&mut response, warning);
+    response
+}
