+pub fn bounded_json_text(content: &str, max: Option<usize>) -> String {
+    let Some(limit) = max else {
+        return content.to_string();
+    };
+    let Some(offset) = content.char_indices().nth(limit).map(|(offset, _)| offset) else {
+        return content.to_string();
+    };
+    format!(
+        "{}\n[truncated: showing {} of {} chars]",
+        &content[..offset],
+        limit,
+        content.chars().count()
+    )
+}
+
+fn is_confirm_wrapper(data: &serde_json::Value) -> bool {
+    data.get("confirmed").and_then(|value| value.as_bool()) == Some(true)
+        && data
+            .get("action")
+            .and_then(|value| value.as_str())
+            .is_some()
+        && data
+            .get("result")
+            .and_then(|result| result.get("success"))
+            .and_then(|value| value.as_bool())
+            .is_some()
+}
+
+fn retained_control_data(
+    data: &serde_json::Value,
+    action: Option<&str>,
+    code: Option<&str>,
+    limit: usize,
+) -> serde_json::Value {
+    let mut retained = serde_json::Map::new();
+    // Native inject_lifecycle owns this top-level field. Eval application data
+    // lives below result and must never be traversed as lifecycle authority.
+    if let Some(lifecycle) = data.get("lifecycle").filter(|value| value.is_object()) {
+        retained.insert("lifecycle".to_string(), lifecycle.clone());
+    }
+    if data
+        .get("confirmation_required")
+        .and_then(|value| value.as_bool())
+        == Some(true)
+    {
+        // The pending-action producers return success:true before executing.
+        // These exact prompt/control fields must survive even --max-output 0.
+        for key in [
+            "confirmation_required",
+            "action",
+            "category",
+            "description",
+            "confirmation_id",
+        ] {
+            if let Some(value) = data.get(key) {
+                retained.insert(key.to_string(), value.clone());
+            }
+        }
+    }
+    if code == Some("tab_gone") {
+        for key in ["targetId", "lastUrl"] {
+            if let Some(value) = data.get(key).filter(|value| value.is_string()) {
+                retained.insert(key.to_string(), value.clone());
+            }
+        }
+    }
+    if action == Some("deny") && data.get("denied").and_then(|value| value.as_bool()) == Some(true)
+    {
+        for key in ["denied", "action"] {
+            if let Some(value) = data.get(key) {
+                retained.insert(key.to_string(), value.clone());
+            }
+        }
+    }
+    if action == Some("confirm") && is_confirm_wrapper(data) {
+        // handle_confirm wraps execute_command's real Response. Outer success
+        // can coexist with nested failure or a second pending confirmation.
+        // Walk only this producer's result.data envelope, never arbitrary eval.
+        retained.insert("confirmed".to_string(), data["confirmed"].clone());
+        retained.insert("action".to_string(), data["action"].clone());
+        let result = &data["result"];
+        let mut nested = serde_json::Map::new();
+        for key in ["id", "success", "code"] {
+            if let Some(value) = result.get(key) {
+                nested.insert(key.to_string(), value.clone());
+            }
+        }
+        for key in ["error", "warning"] {
+            if let Some(value) = result.get(key) {
+                nested.insert(
+                    key.to_string(),
+                    value.as_str().map_or_else(
+                        || value.clone(),
+                        |text| serde_json::Value::String(bounded_json_text(text, Some(limit))),
+                    ),
+                );
+            }
+        }
+        if let Some(nested_data) = result.get("data") {
+            let nested_action = if is_confirm_wrapper(nested_data) {
+                Some("confirm")
+            } else if nested_data.get("denied").and_then(|value| value.as_bool()) == Some(true) {
+                Some("deny")
+            } else {
+                None
+            };
+            nested.insert(
+                "data".to_string(),
+                retained_control_data(
+                    nested_data,
+                    nested_action,
+                    result.get("code").and_then(|value| value.as_str()),
+                    limit,
+                ),
+            );
+        }
+        retained.insert("result".to_string(), serde_json::Value::Object(nested));
+    }
+    if retained.is_empty() {
+        serde_json::Value::Null
+    } else {
+        serde_json::Value::Object(retained)
+    }
+}
