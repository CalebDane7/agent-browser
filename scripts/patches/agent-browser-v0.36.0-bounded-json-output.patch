+pub fn bounded_json_response(
+    resp: &Response,
+    action: Option<&str>,
+    max: Option<usize>,
+) -> Option<Response> {
+    let limit = max?;
+    let mut data = resp.data.clone();
+    let mut omitted = false;
+    if let Some(original) = resp.data.as_ref() {
+        let serialized = serde_json::to_string(original).unwrap_or_default();
+        if serialized.chars().count() > limit {
+            let retained = retained_control_data(original, action, resp.code.as_deref(), limit);
+            if retained != *original {
+                omitted = true;
+                data = if retained.is_null() {
+                    None
+                } else {
+                    Some(retained)
+                };
+            }
+        }
+    }
+    let error = resp
+        .error
+        .as_deref()
+        .map(|text| bounded_json_text(text, max));
+    let mut warning = resp
+        .warning
+        .as_deref()
+        .map(|text| bounded_json_text(text, max));
+    if omitted {
+        let notice = "Result content omitted or truncated by --max-output; action status and control identifiers are unchanged. Do not repeat actions to retrieve omitted output.";
+        warning = Some(match warning {
+            Some(previous) => format!("{}\n{}", previous, notice),
+            None => notice.to_string(),
+        });
+    }
+    if !omitted && error == resp.error && warning == resp.warning {
+        return None;
+    }
+    // WHY: JSON formerly bypassed max_output. Whole-result omission avoids
+    // forging truncated refs/URLs/application values while retaining the actual
+    // operation status; formatter loss must never become a retryable action error.
+    // This is a per-result serialized-character cap, not a total-byte cap.
+    // Existing control fields, IDs/URLs, boundaries and loss notices are overhead
+    // outside it; a batch still has one outcome/command envelope per command.
+    Some(Response {
+        success: resp.success,
+        data,
+        error,
+        code: resp.code.clone(),
+        warning,
+    })
+}
+
+fn format_json_response(resp: &Response, action: Option<&str>, opts: &OutputOptions) -> String {
+    let limited = bounded_json_response(resp, action, opts.max_output);
+    let rendered = limited.as_ref().unwrap_or(resp);
+    if opts.content_boundaries {
+        let mut value = serde_json::to_value(rendered).unwrap_or_default();
+        if let Some(obj) = value.as_object_mut() {
+            // The source origin describes the original response even when its
+            // payload is omitted; never derive a fabricated/truncated URL.
+            let origin = resp
+                .data
+                .as_ref()
+                .and_then(boundary_origin)
+                .unwrap_or("unknown");
+            obj.insert(
+                "_boundary".to_string(),
+                serde_json::json!({ "nonce": get_boundary_nonce(), "origin": origin }),
+            );
+        }
+        serde_json::to_string(&value).unwrap_or_default()
+    } else {
+        // Preserve the original Response field ordering, including with no cap.
+        serde_json::to_string(rendered).unwrap_or_default()
+    }
+}
+
+pub fn format_batch_json_response(
+    resp: &Response,
+    command: &[String],
+    action: Option<&str>,
+    opts: &OutputOptions,
+) -> serde_json::Value {
+    let limited = bounded_json_response(resp, action, opts.max_output);
+    let rendered = limited.as_ref().unwrap_or(resp);
+    let mut result = serde_json::json!({
+        "command": command,
+        "success": rendered.success,
+        "result": rendered.data,
+        "error": rendered.error,
+    });
+    // Keep the existing batch schema, optional code/warning, command identity,
+    // and action-based bail/exit decisions. This does not cap the entire array.
+    if let Some(code) = rendered.code.as_ref() {
+        result["code"] = serde_json::json!(code);
+    }
+    if let Some(warning) = rendered.warning.as_ref() {
+        result["warning"] = serde_json::json!(warning);
+    }
+    result
+}
